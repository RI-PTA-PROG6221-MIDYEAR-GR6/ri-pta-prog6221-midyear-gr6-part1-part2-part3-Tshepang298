<Window x:Class="CyberSecurityChatbot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot - Final POE"
        Height="750" Width="1100"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL (ASCII & Memory) -->
        <Border Grid.Column="0" Background="#111827" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🛡️" FontSize="48" HorizontalAlignment="Center" Foreground="#22D3EE"/>
                    <TextBlock Text="CYBERSECURITY BOT" FontSize="16" FontWeight="Bold" Foreground="#22D3EE" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="ASCII Art" Foreground="#FACC15" FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBlock FontFamily="Consolas" FontSize="8" Foreground="#22D3EE">
<![CDATA[
 ██████╗██╗   ██╗██████╗ ███████╗██████╗
██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗
██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝
╚██████╗   ██║   ██████╔╝███████╗██║  ██║
 ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝
]]>
                    </TextBlock>

                    <TextBlock Text="Memory:" Foreground="#FACC15" FontWeight="Bold" Margin="0,20,0,5"/>
                    <TextBlock x:Name="MemoryDisplay" Foreground="#22D3EE" FontStyle="Italic" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT PANEL (Tabs) -->
        <TabControl Grid.Column="1" Background="#1E293B" BorderThickness="0">

            <!-- CHAT TAB -->
            <TabItem Header="💬 Chat" Background="#0F172A" Foreground="#E2E8F0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ChatScroll" Padding="20" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel"/>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#1E293B" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" FontSize="14" Padding="10" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" KeyDown="InputBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Send" Margin="10,0,0,0" Padding="20,10" Background="#22D3EE" Foreground="#0F172A" FontWeight="Bold" Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TASKS TAB -->
            <TabItem Header="📋 Tasks" Background="#0F172A" Foreground="#E2E8F0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Task Manager" FontSize="20" Foreground="#22D3EE" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="TasksList" Grid.Row="1" Background="#111827" Foreground="#E2E8F0" BorderThickness="0"/>
                </Grid>
            </TabItem>

            <!-- QUIZ TAB -->
            <TabItem Header="🎮 Quiz Game" Background="#0F172A" Foreground="#E2E8F0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Cybersecurity Quiz" FontSize="20" Foreground="#22D3EE" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="QuizQuestionText" Foreground="#E2E8F0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <StackPanel x:Name="QuizOptionsPanel" Orientation="Vertical"/>
                        <TextBlock x:Name="QuizResultText" Foreground="#FACC15" FontWeight="Bold" Margin="0,15,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>